# Redis (reutilizar de AzanoRivers)
REDIS_URL=
REDIS_PASSWORD=
REDIS_USERNAME=

# OpenAI (reutilizar de AzanoRivers)
OPENAI_API_KEY=

# Resend (reutilizar de AzanoRivers)
RESEND_API_KEY=

# Cloudflare R2 (bucket dedicado modus-ratio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://ratiupload.azanolabs.com

# OpenCode Go (key del dashboard de opencode.ai)
OPENCODE_API_KEY=

# Modelos de IA del pipeline de análisis. Cada paso tiene un modelo primario
# y uno de fallback (se usa si el primario falla). Todos tienen default si
# se dejan vacíos, ver src/lib/env.ts.
# Análisis de imagen (describe el outfit a partir de la foto, ambos vía OpenAI)
IMAGE_ANALYSIS_MODEL=gpt-4o-mini
IMAGE_ANALYSIS_FALLBACK_MODEL=gpt-4o
# Análisis de contexto (puntúa el outfit ya descrito; primario vía OpenCode Go, fallback vía OpenAI)
CONTEXT_ANALYSIS_MODEL=glm-5.2
CONTEXT_ANALYSIS_FALLBACK_MODEL=gpt-4o-mini

# App
APP_URL=http://localhost:4321

# Rate limit de análisis de outfit por IP (PUBLIC_ porque también alimenta
# el countdown del cliente, ver src/lib/constants.ts)
PUBLIC_RATE_LIMIT_USAGE_LIMIT=5
PUBLIC_RATE_LIMIT_USAGE_WINDOW_MINUTES=15
